// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  BUYER
  MERCHANT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED // Legitimate — merchant can add products; not yet visible to buyers
  PENDING_GO_LIVE // 2nd review gate — admin verifies launch readiness
  ACTIVE // Live and visible to buyers
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

// Buyer-app gender taxonomy (maya FeedTabs: Women / Men / Home & Lifestyle).
// Drives the mobile /api/products/feed, /new-arrivals and /merchants/trending
// filtering. UNISEX products surface in BOTH women and men feeds. "Home &
// Lifestyle" is a separate axis not yet modelled — that tab is an empty
// placeholder for v1 (see maya open-questions P-4 / ST-7).
enum GenderType {
  WOMEN
  MEN
  UNISEX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  RECONCILE_REQUIRED // late ITN arrived after local cancel; ops must resolve manually
}

// Distinguishes the kind of PayFast event in a PaymentEvent row.
// PAYMENT covers initial transaction status (PENDING/COMPLETED/FAILED/CANCELLED).
// REFUND covers refund-specific ITNs (PARTIALLY_REFUNDED/REFUNDED).
enum ItnTxType {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CREDIT_CARD // cc
  DEBIT_CARD // dc
  INSTANT_EFT // ef
  DELAYED_EFT // Delayed EFT
  MOBICRED // mc
  SNAPSCAN // ss
  MASTERPASS // mp
  STORE_CREDIT // sc (PayFast store credit / wallet)
  ZAPPER // zp
  PAYPAL // pp
  RCS // rc
  APPLE_PAY // ap
  SAMSUNG_PAY // sp
}

enum ShipmentStatus {
  PENDING
  COLLECTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
}

// Distinguishes the kind of webhook event in a ShipmentEvent row.
// TRACKING_EVENT is the buyer-visible status change pipeline (collected, at-hub,
// delivered, etc.). The other three are admin/ops-relevant only — they're stored
// for audit/idempotency but don't drive Order.status transitions.
enum ShipmentEventType {
  TRACKING_EVENT
  SHIPMENT_NOTE
  ADDRESS_CHANGE
  DIMENSION_CHANGE
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYOUT_COMPLETED
  NEW_REVIEW
  NEW_FOLLOWER
  PROMOTION
  SYSTEM
}

enum ContentType {
  IMAGE
  VIDEO
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  AWAITING_MERCHANT
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

// Buyer↔merchant chat. senderType distinguishes who wrote a message — the
// buyer (maya app) or the merchant (store owner/employee via the dashboard).
enum MessageSenderType {
  BUYER
  MERCHANT
}

enum ConversationReportReason {
  HARASSMENT
  SCAM
  SPAM
  OTHER
}

// ============================================================================
// USERS & AUTH
// ============================================================================

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  phone          String?       @unique
  passwordHash   String
  firstName      String
  lastName       String
  avatarUrl      String?
  role           UserRole      @default(BUYER)
  accountStatus  AccountStatus @default(PENDING_VERIFICATION)
  emailVerified  Boolean       @default(false)
  phoneVerified  Boolean       @default(false)
  lastLoginAt    DateTime?
  isGuestAccount Boolean       @default(false)

  // Auth tokens (hashed before storage)
  verificationToken  String?
  verificationExpiry DateTime?
  resetToken         String?
  resetExpiry        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  store            Store?
  addresses        Address[]
  orders           Order[]
  cart             Cart?
  wishlistItems    WishlistItem[]
  reviews          Review[]
  notifications    Notification[]
  supportTickets   SupportTicket[]
  followedStores   StoreFollower[]
  refreshTokens    RefreshToken[]
  pushTokens       PushToken[]
  storeEmployments StoreEmployee[]
  conversations    Conversation[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique // Expo push token (ExponentPushToken[...])
  userId     String
  platform   String // 'ios' | 'android'
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Address {
  id            String    @id @default(cuid())
  userId        String
  label         String? // e.g. "Home", "Work"
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  suburb        String?   @db.VarChar(100) // SA address component — maps to ShipLogic `local_area`
  city          String
  province      String
  postalCode    String
  country       String    @default("South Africa")
  isDefault     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("addresses")
}

// ============================================================================
// STORES / BRANDS
// ============================================================================

model Store {
  id              String      @id @default(cuid())
  ownerId         String      @unique
  companyName     String      @unique // Registered legal entity name (CIPC). Used for invoices, payouts, compliance.
  displayName     String      @unique // Public-facing brand name. Shown to buyers everywhere.
  slug            String      @unique // URL-friendly identifier derived from displayName
  description     String?
  story           String? // Brand story for discovery/community
  websiteUrl      String? // Brand's external website. Optional throughout entire lifecycle.
  logoUrl         String?
  status          StoreStatus @default(DRAFT)
  rejectionReason String? // Set by admin on rejection. Cleared on edit or resubmission.

  // Contact & business info
  contactEmail  String?
  contactPhone  String?
  businessRegNo String? // CIPC registration
  vatNumber     String?

  // Payout info
  bankName        String?
  bankAccountNo   String?
  bankBranchCode  String?
  bankAccountType String?

  // Metrics (denormalized for performance)
  totalSales    Int     @default(0)
  totalRevenue  Decimal @default(0) @db.Decimal(12, 2)
  averageRating Float   @default(0)
  followerCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner             User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products          Product[]
  categories        StoreCategory[]
  orders            Order[]
  payouts           Payout[]
  followers         StoreFollower[]
  contentPosts      ContentPost[]
  promotions        Promotion[]
  addresses         StoreAddress[]
  employees         StoreEmployee[]
  collections       StoreCollection[]
  dispatchAddresses StoreDispatchAddress[]
  bannerMedia       StoreBannerMedia[]
  conversations     Conversation[]

  @@index([slug])
  @@index([status])
  @@map("stores")
}

model StoreFollower {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("store_followers")
}

// Banner gallery: up to 5 items per store, mix of images and videos.
// Replaces the legacy single Store.bannerUrl field. Cover is the item with
// the lowest sortOrder (isPrimary: true). Mutations renumber sortOrder to
// stay contiguous (0..N-1). See docs/Api-frontend-contracts/store-banner-media.md.
model StoreBannerMedia {
  id        String    @id @default(cuid())
  storeId   String
  url       String
  mediaType MediaType
  sortOrder Int       @default(0)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sortOrder])
  @@map("store_banner_media")
}

// Physical locations for the store's public profile (not shipping logistics)
model StoreAddress {
  id           String   @id @default(cuid())
  storeId      String
  streetNumber String
  streetName   String
  buildingName String? // Building, complex, mall, or shopping centre name
  suburb       String? @db.VarChar(100) // SA address component — sits between building and city
  city         String
  postalCode   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_addresses")
}

// Dispatch / pickup origin for ShipLogic. Separate from StoreAddress because dispatch
// locations need full logistics fields (province, pickup contact, lat/lng) and do not
// leak into the store's public profile. A merchant may have multiple (multi-location)
// but exactly one primary.
model StoreDispatchAddress {
  id      String  @id @default(cuid())
  storeId String
  label   String? // e.g. "Warehouse", "Studio", "Home"

  // Pickup contact (ShipLogic requires)
  contactName  String
  contactPhone String

  // Full address (ShipLogic rate-endpoint requirements)
  addressLine1 String
  addressLine2 String?
  suburb       String?
  city         String
  province     String
  postalCode   String
  country      String  @default("South Africa")

  // Optional for rate accuracy
  latitude  Float?
  longitude Float?

  isPrimary Boolean   @default(false)
  deletedAt DateTime? // soft-delete — historical Order rows still reference the row via shippingDispatchAddressId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([storeId])
  @@index([storeId, deletedAt])
  @@map("store_dispatch_addresses")
}

// Team members invited to help manage a store
model StoreEmployee {
  id             String    @id @default(cuid())
  storeId        String
  userId         String? // Null until invite is accepted and linked to a YIIVA account
  email          String // Email the invite was sent to
  employeeNumber String? // Optional identifier provided by the employee
  inviteToken    String? // SHA-256 hash of invite token. Raw token sent via email.
  inviteExpiry   DateTime?
  acceptedAt     DateTime? // Null until invite accepted
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([storeId, email])
  @@index([storeId])
  @@index([userId])
  @@index([email])
  @@map("store_employees")
}

// Merchant-created product groupings within a store (e.g. "Summer 2025", "Limited Edition")
// Store-scoped only — does not affect platform-wide discovery
model StoreCollection {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products ProductCollection[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("store_collections")
}

// Join table: many-to-many between Product and StoreCollection
model ProductCollection {
  id           String   @id @default(cuid())
  productId    String
  collectionId String
  createdAt    DateTime @default(now())

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection StoreCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@map("product_collections")
}

// ============================================================================
// PRODUCTS & CATALOG
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]        @relation("CategoryTree")
  products        ProductCategory[]
  storeCategories StoreCategory[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model StoreCategory {
  id         String   @id @default(cuid())
  storeId    String
  categoryId String
  createdAt  DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([storeId, categoryId])
  @@map("store_categories")
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  title       String
  slug        String
  description String?
  status      ProductStatus @default(DRAFT)

  // Buyer-app gender taxonomy. Nullable — products without a gender are
  // excluded from the mobile gender-filtered feeds. Set by admin / seed.
  genderType GenderType?

  // Pricing (in ZAR cents to avoid floating point issues)
  priceInCents        Int
  comparePriceInCents Int? // Original/compare-at price for showing discounts
  costInCents         Int? // Cost price for margin calculations

  // Inventory — bare SKU only. Each variant has independent stock.
  // Product-overall availability = totalStock + Σ(variants.stock).
  sku               String?
  totalStock        Int     @default(0)
  reservedStock     Int     @default(0)
  lowStockThreshold Int     @default(5)

  // Shipping
  weightInGrams Int?
  lengthCm      Float?
  widthCm       Float?
  heightCm      Float?

  // SEO / Discovery
  metaTitle       String?
  metaDescription String?

  // Metrics (denormalized)
  totalSold     Int   @default(0)
  viewCount     Int   @default(0)
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  isFeatured  Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  images          ProductImage[]
  categories      ProductCategory[]
  tags            ProductTag[]
  collections     ProductCollection[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  contentProducts ContentPostProduct[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([status])
  @@index([priceInCents])
  @@index([createdAt])
  @@index([isFeatured])
  @@index([genderType])
  @@map("products")
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  name          String // e.g. "Black / Medium"
  sku           String? @unique
  priceInCents  Int? // Override product price if set
  stock         Int     @default(0)
  reservedStock Int     @default(0)
  sortOrder     Int     @default(0)

  // Variant options
  color    String?
  size     String?
  material String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  url       String
  altText   String?
  mediaType MediaType @default(IMAGE)
  sortOrder Int       @default(0)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_categories")
}

// ============================================================================
// AI TAGGING & DISCOVERY
// ============================================================================

model Tag {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  isAiGenerated Boolean  @default(false)
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())

  products ProductTag[]

  @@index([slug])
  @@index([usageCount])
  @@map("tags")
}

model ProductTag {
  id            String   @id @default(cuid())
  productId     String
  tagId         String
  confidence    Float? // AI confidence score (0-1) if AI-generated
  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@map("product_tags")
}

// ============================================================================
// CONTENT / SHOPPABLE MEDIA
// ============================================================================

model ContentPost {
  id           String      @id @default(cuid())
  storeId      String
  caption      String?
  contentType  ContentType
  mediaUrl     String
  thumbnailUrl String?
  viewCount    Int         @default(0)
  likeCount    Int         @default(0)
  isPublished  Boolean     @default(false)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  store    Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products ContentPostProduct[]

  @@index([storeId])
  @@index([isPublished, createdAt])
  @@map("content_posts")
}

model ContentPostProduct {
  id            String   @id @default(cuid())
  contentPostId String
  productId     String
  // Position of product tag overlay on the media (for shoppable tags)
  positionX     Float?
  positionY     Float?
  createdAt     DateTime @default(now())

  contentPost ContentPost @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([contentPostId, productId])
  @@map("content_post_products")
}

// ============================================================================
// CART & WISHLIST
// ============================================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @default(cuid()) // Human-readable order number
  userId      String
  storeId     String
  addressId   String

  status OrderStatus @default(PENDING)

  // Amounts (ZAR cents)
  subtotalInCents Int
  shippingInCents Int @default(0)
  discountInCents Int @default(0)
  totalInCents    Int

  // Shipping context (ShipLogic quote + merchant dispatch origin)
  shippingQuoteId           String?
  shippingServiceTier       String?
  shippingDispatchAddressId String?

  // Snapshot of delivery address at time of order
  shippingName       String
  shippingPhone      String
  shippingAddress1   String
  shippingAddress2   String?
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String
  shippingCountry    String  @default("South Africa")

  notes        String? // Customer notes
  cancelReason String?

  placedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user            User                  @relation(fields: [userId], references: [id])
  store           Store                 @relation(fields: [storeId], references: [id])
  address         Address               @relation(fields: [addressId], references: [id])
  dispatchAddress StoreDispatchAddress? @relation(fields: [shippingDispatchAddressId], references: [id])
  items           OrderItem[]
  payment         Payment?
  shipment        Shipment?
  promotionUsage  PromotionUsage?

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([orderNumber])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  variantId        String?
  quantity         Int
  unitPriceInCents Int
  totalInCents     Int

  // Snapshot of product details at time of order
  productTitle    String
  variantName     String?
  productImageUrl String?

  createdAt DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ============================================================================
// PAYMENTS (PayFast Integration)
// ============================================================================

// Represents one PayFast transaction. A single transaction can cover multiple Orders
// (multi-brand cart → multi-order checkout). All PayFast ITN / signature / payload
// fields live here because they describe the transaction, not an individual order.
model PaymentGroup {
  id          String        @id @default(cuid())
  mPaymentId  String        @unique
  pfPaymentId String?
  status      PaymentStatus @default(PENDING)

  amountGrossInCents Int
  amountFeeInCents   Int @default(0)
  amountNetInCents   Int
  shippingInCents    Int @default(0) // flat shipping fee lives here, not on individual Orders

  method PaymentMethod?

  // PayFast ITN / verification
  pfSignature    String?
  itnPayload     Json?
  pfToken        String?
  pfNameFirst    String?
  pfNameLast     String?
  pfEmailAddress String?

  paidAt    DateTime?
  failedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payments Payment[]
  events   PaymentEvent[]

  @@index([mPaymentId])
  @@index([status])
  @@map("payment_groups")
}

// Per-order slice of a PaymentGroup. Holds this order's share of the gross/fee/net split
// plus eager commission math (locked at payment time, immune to later rate changes).
model Payment {
  id             String @id @default(cuid())
  orderId        String @unique
  paymentGroupId String

  status PaymentStatus @default(PENDING)

  // This order's portion of the payment group
  amountGrossInCents Int
  amountFeeInCents   Int @default(0) // proportional PayFast fee
  amountNetInCents   Int

  // Eager commission math (locked at payment time; immune to rate changes)
  platformCommissionInCents Int @default(0) // YIIVA 5.5% take
  merchantPayoutInCents     Int @default(0) // amountNet - platformCommission

  // Refund tracking
  refundedAmountInCents Int @default(0)

  paidAt     DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentGroup PaymentGroup @relation(fields: [paymentGroupId], references: [id], onDelete: Cascade)

  @@index([paymentGroupId])
  @@index([status])
  @@map("payments")
}

// Audit log of every PayFast ITN we receive. The unique constraint on itnHash
// is the idempotency primitive: PayFast retries (up to 11 times over 2 days)
// or accidental duplicates fail at INSERT and are acked as 200 no-ops.
// PaymentGroup.status is the materialized projection of the latest accepted event.
model PaymentEvent {
  id              String        @id @default(cuid())
  paymentGroupId  String
  itnHash         String        @unique // sha256(canonicalize(payload)) — dedupe key
  pfPaymentId     String?
  status          PaymentStatus // status carried by this ITN
  transactionType ItnTxType // PAYMENT or REFUND

  payload   Json // full ITN body, parsed
  signature String // PayFast's signature on this ITN
  sourceIp  String?

  receivedAt   DateTime @default(now())
  processed    Boolean  @default(false)
  processError String? // null if processed; reason string if rejected/skipped

  paymentGroup PaymentGroup @relation(fields: [paymentGroupId], references: [id], onDelete: Cascade)

  @@index([paymentGroupId, receivedAt])
  @@index([pfPaymentId])
  @@map("payment_events")
}

// ============================================================================
// MERCHANT PAYOUTS
// ============================================================================

model Payout {
  id               String       @id @default(cuid())
  storeId          String
  amountInCents    Int
  feeInCents       Int          @default(0) // Platform commission deducted
  netAmountInCents Int
  status           PayoutStatus @default(PENDING)
  reference        String? // Bank transfer reference
  periodStart      DateTime // Payout period start
  periodEnd        DateTime // Payout period end
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([status])
  @@map("payouts")
}

// ============================================================================
// SHIPPING / DELIVERY (The Courier Guy Integration)
// ============================================================================

model Shipment {
  id      String         @id @default(cuid())
  orderId String         @unique
  status  ShipmentStatus @default(PENDING)

  // ShipLogic/TCG references
  shiplogicShipmentId String? @unique // ShipLogic's internal shipment ID (numeric, e.g. 115738667)
  // Populated from ShipLogic's `short_tracking_reference` field (e.g. "VD3GLQ").
  // This IS the printed waybill number for TCG-issued shipments — the two are the
  // same value. Used as the webhook lookup key (incoming tracking events carry
  // `short_tracking_reference` and we match Shipment by this column).
  waybillNumber       String? @unique
  trackingUrl         String? // Public tracking URL (tcg.shiplogic.com/track)
  serviceType         String? // e.g. "LOF" (Local Overnight Flyer), "LOX", "ECO", "NFS"

  // ShipLogic shipment status: creating, created, cancelling, cancelled, manifesting, manifested, failed
  shiplogicStatus String?

  // Quote / Rate info
  quoteId          String? // ShipLogic quote reference
  rateInCents      Int? // Shipping cost from ShipLogic rates endpoint
  rateExVatInCents Int? // Rate excluding VAT

  // Parcel details sent to ShipLogic
  parcelCount        Int     @default(1)
  totalWeightInGrams Int?
  parcelDescription  String?

  // Collection & delivery
  collectionDate    DateTime? // Earliest collection date sent to ShipLogic
  estimatedDelivery DateTime?
  collectedAt       DateTime?
  deliveredAt       DateTime?

  // Proof of delivery
  podUrl      String? // POD document URL
  deliveryOtp String? // OTP pin used for delivery confirmation

  // Raw ShipLogic API response for auditing
  shiplogicPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingEvents ShipmentTrackingEvent[]
  events         ShipmentEvent[]

  @@index([waybillNumber])
  @@index([shiplogicShipmentId])
  @@index([status])
  @@map("shipments")
}

// Buyer-visible tracking history. Populated by the webhook processor AFTER
// dedupe via ShipmentEvent, for the subset of events worth surfacing on order
// detail screens ("Collected at JHB hub", "Out for delivery", etc.).
model ShipmentTrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      String // e.g. "Collected", "In Transit", "At Hub", "Out for Delivery", "Delivered"
  description String? // Detailed tracking message from ShipLogic
  location    String? // Branch/hub location if available
  timestamp   DateTime // When the event occurred (from ShipLogic)
  createdAt   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, timestamp])
  @@map("shipment_tracking_events")
}

// Audit log of every webhook we receive from ShipLogic. The unique constraint
// on `payloadHash` is the idempotency primitive: ShipLogic retries (or accidental
// duplicates) fail at INSERT and are acked as 200 no-ops. Mirrors the
// PaymentEvent pattern from the payments module.
//
// Shipment.status is the materialised projection of accepted events; the
// buyer-facing ShipmentTrackingEvent is the filtered subset (TRACKING_EVENT
// only) suitable for the order-detail timeline.
model ShipmentEvent {
  id            String            @id @default(cuid())
  shipmentId    String? // FK; nullable when the inbound webhook can't be matched to a known Shipment
  waybillNumber String // from payload — used to look up Shipment when shipmentId is null
  payloadHash   String            @unique // sha256(canonicalize(payload)) — dedupe key
  eventType     ShipmentEventType
  rawStatus     String? // raw ShipLogic status string before mapping (debugging)
  payload       Json
  sourceIp      String?

  receivedAt   DateTime @default(now())
  processed    Boolean  @default(false)
  processError String? // null if processed; reason string if rejected/skipped

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([shipmentId, receivedAt])
  @@index([waybillNumber])
  @@map("shipment_events")
}

// ============================================================================
// REVIEWS & RATINGS
// ============================================================================

model Review {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  rating      Int // 1-5
  title       String?
  body        String?
  isVerified  Boolean  @default(false) // Verified purchase
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // One review per product per user
  @@index([productId])
  @@index([rating])
  @@map("reviews")
}

// ============================================================================
// PROMOTIONS & DISCOUNTS
// ============================================================================

model Promotion {
  id              String       @id @default(cuid())
  storeId         String
  code            String
  description     String?
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2) // Percentage or fixed amount
  minOrderInCents Int? // Minimum order value to apply
  maxUsage        Int? // Total usage limit
  usageCount      Int          @default(0)
  maxUsagePerUser Int          @default(1)
  isActive        Boolean      @default(true)
  startsAt        DateTime
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  store  Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  usages PromotionUsage[]

  @@unique([storeId, code])
  @@index([code])
  @@index([isActive])
  @@map("promotions")
}

model PromotionUsage {
  id          String   @id @default(cuid())
  promotionId String
  orderId     String   @unique
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@map("promotion_usages")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json? // Flexible payload (orderId, productId, etc.)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// CUSTOMER SUPPORT
// ============================================================================

model SupportTicket {
  id          String                @id @default(cuid())
  userId      String
  orderId     String? // Optional link to order
  subject     String
  description String
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  resolvedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String
  senderType  String // "USER", "MERCHANT", "ADMIN"
  senderId    String
  body        String
  attachments Json? // Array of attachment URLs
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

// ============================================================================
// CHAT / MESSAGING (Buyer ↔ Merchant)
// ============================================================================

// One conversation per (buyer, store) pair — the unique constraint makes the
// "get or create by merchant" call idempotent. Real-time delivery is layered
// on top via a socket.io gateway; this table is the durable source of truth,
// shared by the buyer app and the merchant dashboard.
model Conversation {
  id      String @id @default(cuid())
  buyerId String
  storeId String

  // Per-participant read markers (unread counts derive from these).
  buyerLastReadAt    DateTime?
  merchantLastReadAt DateTime?
  lastMessageAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer    User                 @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  store    Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages Message[]
  reports  ConversationReport[]

  @@unique([buyerId, storeId])
  @@index([storeId, lastMessageAt])
  @@index([buyerId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderType     MessageSenderType
  senderId       String // userId of the buyer or the merchant member; no FK relation
  text           String?
  attachments    Json? // array of polymorphic attachments (image / product / order)
  orderId        String? // optional order context (chat opened from Track Order)
  idempotencyKey String? // client-supplied; dedupes retried sends within a conversation

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model ConversationReport {
  id             String                   @id @default(cuid())
  conversationId String
  reporterId     String // userId of the reporter; no FK relation
  reason         ConversationReportReason
  details        String?
  createdAt      DateTime                 @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_reports")
}

// ============================================================================
// WAITLIST (Pre-launch)
// ============================================================================

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // Where they signed up from
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}

// ============================================================================
// SEARCH & ANALYTICS EVENTS (for real-time insights)
// ============================================================================

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String // e.g. "product_view", "search", "add_to_cart", "purchase"
  userId    String?
  storeId   String?
  productId String?
  metadata  Json? // Flexible event data
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}
