# Copy this file to .env and fill in your values
# Never commit .env to version control

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nuwa_dev?schema=public"

# JWT — Access token (short-lived, never stored in DB)
JWT_SECRET=""
JWT_EXPIRES_IN="15m"

# Refresh token TTL in days (stored in DB, revocable)
REFRESH_TOKEN_EXPIRES_IN_DAYS="7"

# Resend — transactional email
RESEND_API_KEY=""

# Sender identity — format: Display Name <email@domain>
EMAIL_FROM="YIIVA <noreply@yiiva.co.za>"

# Frontend base URL — used to build email verification and password reset links
FRONTEND_URL="https://yiiva.co.za"

# App
PORT="3000"

# CORS allowlist — comma-separated frontend origins authorised to call this API.
# Each entry must be a full origin (protocol + host + optional port), no paths or wildcards.
# Production REQUIRED — boot fails if NODE_ENV=production and this is unset.
# Non-production: defaults to http://localhost:3000,http://localhost:3001 if unset.
# Example: CORS_ORIGINS="https://yiiva.co.za,https://staging.yiiva.co.za"
CORS_ORIGINS=""

# Admin seed — used by `npx prisma db seed` to create platform admin accounts.
# Add one block per admin. Increment the number for each additional founder.
# Remove the password vars from .env after first login and password rotation.
ADMIN_1_EMAIL=""
ADMIN_1_PASSWORD=""
ADMIN_1_FIRST_NAME=""
ADMIN_1_LAST_NAME=""

# ADMIN_2_EMAIL=""
# ADMIN_2_PASSWORD=""
# ADMIN_2_FIRST_NAME=""
# ADMIN_2_LAST_NAME=""

# ============================================================================
# PayFast — South African payment gateway
# ============================================================================
# Public sandbox credentials for local dev:
#   PAYFAST_MERCHANT_ID=10000100
#   PAYFAST_MERCHANT_KEY=46f0cd694581a
#   PAYFAST_PASSPHRASE=jt7NOE43FZPn
#   PAYFAST_SANDBOX=true
# Production: replace with real merchant credentials, set PAYFAST_SANDBOX=false.

PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""

# true = use sandbox.payfast.co.za + ?testing=true on API; false = production
PAYFAST_SANDBOX="true"

# Buyer redirect URLs (frontend pages)
PAYFAST_RETURN_URL="https://yiiva.co.za/checkout/success"
PAYFAST_CANCEL_URL="https://yiiva.co.za/checkout/cancel"

# Server-to-server ITN webhook URL (this API). Must be publicly reachable.
# For local dev with ngrok: https://<your-ngrok-id>.ngrok.io/payments/notify
PAYFAST_NOTIFY_URL="https://api.yiiva.co.za/payments/notify"

# REST API version header (PayFast default v1)
PAYFAST_API_VERSION="v1"

# Comma-separated allowlist of PayFast egress hostnames. Defaults to the four
# canonical hosts if unset. Override only if PayFast announces a new host.
# PAYFAST_NOTIFY_HOSTS="www.payfast.co.za,sandbox.payfast.co.za,w1w.payfast.co.za,w2w.payfast.co.za"

# DEV ONLY: skip the source-IP check for ITN. Refused at boot if NODE_ENV=production.
# Use with ngrok during local development since ngrok rewrites the source IP.
PAYFAST_SKIP_IP_CHECK="false"

# Express trust-proxy hop count for req.ip resolution.
# Railway adds 1 edge hop. Bump to 2 if Cloudflare or another proxy fronts the app.
TRUST_PROXY="1"

# ============================================================================
# Cloudinary — image and video hosting
# ============================================================================
# YIIVA uses one Cloudinary cloud per environment (yiiva-dev, yiiva-prod).
# The backend uses these to generate signed upload payloads — the actual file
# uploads still happen browser-direct to Cloudinary, not through this API.
#
# CLOUDINARY_CLOUD_NAME    — the cloud's name in the Cloudinary dashboard.
#                            Non-secret; the frontend reads the same value via
#                            NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME (set in the
#                            frontend repo's env).
# CLOUDINARY_API_KEY       — non-secret; sent to the frontend in the signed
#                            response so it can call the Cloudinary upload API.
# CLOUDINARY_API_SECRET    — SECRET. Used only by the backend to compute SHA-1
#                            signatures for unsigned-from-the-frontend uploads.
#                            Never log, never expose to the frontend.
#
# All three are required at boot. Backend fails fast if any are missing.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================================
# ShipLogic / The Courier Guy — shipping
# ============================================================================
# ShipLogic is the platform underneath The Courier Guy. Free sandbox at
# https://sandbox.shiplogic.com/register — register, verify email, generate
# an API key under Settings > API Keys.
#
# Sandbox vs production:
#   SHIPLOGIC_BASE_URL=https://api.shiplogic.com                  (sandbox; free)
#   SHIPLOGIC_BASE_URL=https://api.portal.thecourierguy.co.za     (production; requires TCG business account)
#
# Both required. Boot fails fast if either is missing.
SHIPLOGIC_BASE_URL="https://api.shiplogic.com"
SHIPLOGIC_API_KEY=""

# Default ShipLogic service-level code for new shipments. ECO is cheapest;
# LOF/LOX/NFS are upgrades. Optional, defaults to "ECO".
SHIPLOGIC_DEFAULT_SERVICE_LEVEL="ECO"

# Per-product weight fallback (grams) when Product.weightInGrams is null.
# Optional, defaults to 500. See shipping-module-foundation.md Q16.
SHIPPING_DEFAULT_WEIGHT_GRAMS="500"

# Fixed parcel dimensions (cm) for v1 — every shipment uses these.
# ShipLogic re-dimensions at the hub if wrong. See foundation.md Q17.
SHIPPING_DEFAULT_LENGTH_CM="20"
SHIPPING_DEFAULT_WIDTH_CM="20"
SHIPPING_DEFAULT_HEIGHT_CM="10"

# Fallback rate (cents) when ShipLogic /rates is unreachable or returns 5xx.
# Buyer never sees "rates unavailable" at checkout — degrades gracefully.
# Default 11000 = R110 (matches the original stub).
SHIPPING_RATE_FALLBACK_CENTS="11000"

# Webhook path-embedded secret. Subscribe ShipLogic to:
#   POST {YOUR_API_PUBLIC_URL}/shipping/webhook/{SHIPLOGIC_WEBHOOK_SECRET}
# Used as defence-in-depth alongside the IP allowlist until signing is
# confirmed (open question Q24). Generate as a 32+ char random string.
# Required when Phase 6 (webhook handler) ships; optional/unset earlier.
SHIPLOGIC_WEBHOOK_SECRET=""

# Optional IP allowlist for incoming webhooks. Comma-separated. Empty means
# no IP gate. Populate once TCG support confirms outbound IPs.
SHIPLOGIC_WEBHOOK_IP_ALLOWLIST=""
